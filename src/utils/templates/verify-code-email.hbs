<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="fr">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verification Code</title>
</head>
<body style="margin: 0; padding: 0; background-color: #F9FAFB; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">
<table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #F9FAFB; padding: 40px 10px;">
    <tr>
        <td align="center">
            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 500px; background-color: #ffffff; border-radius: 12px; border: 1px solid #F3F4F6; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
                <tr>
                    <td style="padding: 40px 30px; text-align: center;">

                        <table border="0" cellpadding="0" cellspacing="0" align="center" style="margin-bottom: 24px;">
                            <tr>
                                <td align="center">
                                    <img src="https://s3.us-west-004.backblazeb2.com/backblazetestbucket/7b3dc9da-67cd-4ded-a38b-4265ee3e75bf-Frame_1321317017.png" alt="Login" width="60" style="display: block; border: 0;">
                                </td>
                            </tr>
                        </table>

                        <h1 style="color: #344054; font-size: 22px; font-weight: 600; margin: 0 0 30px 0; letter-spacing: -0.02em;">
                            Your Rent ROI Login code
                        </h1>

                        <table border="0" cellpadding="0" cellspacing="0" width="100%" style="border: 1px solid #F2F4F7; border-radius: 8px; padding: 30px 20px;">
                            <tr>
                                <td align="center">
                                    <p style="color: #667085; font-size: 14px; line-height: 1.5; margin: 0 0 25px 0;">
                                        Use the verification code below to securely sign in to your Rent ROI account:
                                    </p>

                                    <table border="0" cellpadding="0" cellspacing="0" align="center" style="margin-bottom: 30px;">
                                        <tr>
                                            <td style="padding: 0 4px;">
                                                <table border="0" cellpadding="0" cellspacing="0">
                                                    <tr>
                                                        <td align="center" style="width: 45px; height: 45px; background-color: #F2F4F7; border-radius: 50%; color: #344054; font-size: 20px; font-weight: 600;">{{number1}}</td>
                                                    </tr>
                                                </table>
                                            </td>
                                            <td style="padding: 0 4px;">
                                                <table border="0" cellpadding="0" cellspacing="0">
                                                    <tr>
                                                        <td align="center" style="width: 45px; height: 45px; background-color: #F2F4F7; border-radius: 50%; color: #344054; font-size: 20px; font-weight: 600;">{{number2}}</td>
                                                    </tr>
                                                </table>
                                            </td>
                                            <td style="padding: 0 4px;">
                                                <table border="0" cellpadding="0" cellspacing="0">
                                                    <tr>
                                                        <td align="center" style="width: 45px; height: 45px; background-color: #F2F4F7; border-radius: 50%; color: #344054; font-size: 20px; font-weight: 600;">{{number3}}</td>
                                                    </tr>
                                                </table>
                                            </td>
                                            <td style="padding: 0 4px;">
                                                <table border="0" cellpadding="0" cellspacing="0">
                                                    <tr>
                                                        <td align="center" style="width: 45px; height: 45px; background-color: #F2F4F7; border-radius: 50%; color: #344054; font-size: 20px; font-weight: 600;">{{number4}}</td>
                                                    </tr>
                                                </table>
                                            </td>
                                            <td style="padding: 0 4px;">
                                                <table border="0" cellpadding="0" cellspacing="0">
                                                    <tr>
                                                        <td align="center" style="width: 45px; height: 45px; background-color: #F2F4F7; border-radius: 50%; color: #344054; font-size: 20px; font-weight: 600;">{{number5}}</td>
                                                    </tr>
                                                </table>
                                            </td>
                                            <td style="padding: 0 4px;">
                                                <table border="0" cellpadding="0" cellspacing="0">
                                                    <tr>
                                                        <td align="center" style="width: 45px; height: 45px; background-color: #F2F4F7; border-radius: 50%; color: #344054; font-size: 20px; font-weight: 600;">{{number6}}</td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>

                                    <div style="height: 1px; background-color: #F2F4F7; margin-bottom: 25px;"></div>

                                    <p style="color: #667085; font-size: 13px; line-height: 1.5; margin: 0;">
                                        Please enter the OTP code within 6 minutes of receiving this email to complete the verification process.
                                    </p>
                                </td>
                            </tr>
                        </table>

                    </td>
                </tr>
            </table>

            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 500px; margin-top: 40px; text-align: center;">
                <tr>
                    <td align="center">
                        <div style="width: 48px; height: 48px; background-color: #2B4E32; border-radius: 50%; display: inline-block; vertical-align: middle;">
                            <img src="https://s3.us-west-004.backblazeb2.com/backblazetestbucket/3b02cd94-38ef-4c91-a9c8-2bb472ef644a-RENTROI_Emaillogo.png" alt="Logo" width="30" style="padding-top: 10px; display: block; border: 0; margin: 0 auto;">
                        </div>

                        <div style="color: #697586; font-size: 14px; margin: 16px 0 4px; font-weight: 400;">
                            © {{year}} Rent Roi All rights reserved.
                        </div>

                        <div style="color: #344054; font-size: 14px; font-weight: 400;">
                            Contact us at
                            <a href="mailto:support@rentroi.uk" style="color: #3B82F6; text-decoration: none; font-size: 13px;">
                                support@rentroi.uk
                            </a>
                        </div>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>