<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="fr">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome to RENT ROI</title>
</head>
<body style="margin: 0; padding: 0; background-color: #F9FAFB; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">
<table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #F9FAFB; padding: 40px 10px;">
    <tr>
        <td align="center">
            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 500px; background-color: #ffffff; border-radius: 12px; border: 1px solid #F3F4F6; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
                <tr>
                    <td style="padding: 48px 32px; text-align: center;">

                        <table border="0" cellpadding="0" cellspacing="0" align="center" style="margin: 0 auto;">
                            <tr>
                                <td align="center" style="width: 47px; height: 47px; background-color: #ffffff; vertical-align: middle;">
                                    <img src="https://s3.us-west-004.backblazeb2.com/backblazetestbucket/5688ad5d-53db-4afe-a614-38828001818e-clipboard-check.png" alt="Check" width="30" style="display: block; border: 0;">
                                </td>
                            </tr>
                        </table>

                        <h1 style="color: #344054; font-size: 24px; font-weight: 600; margin: 24px 0; letter-spacing: -0.025em; line-height: 1.2;">
                            Welcome to RENT ROI
                        </h1>

                        <table border="0" cellpadding="0" cellspacing="0" width="100%">
                            <tr>
                                <td style="height: 1px; background-color: #F2F4F7; font-size: 1px; line-height: 1px;">&nbsp;</td>
                            </tr>
                        </table>

                        <p style="color: #475467; font-size: 15px; line-height: 1.6; margin: 20px 0 0; padding: 0 10px;">
                            Congratulations! Your registration on RENT ROI has been successfully confirmed.
                            You can now start using real estate analysis tools designed to help you evaluate deals,
                            compare scenarios, and make smarter investment decisions.
                        </p>
                    </td>
                </tr>
            </table>

            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 500px; margin-top: 40px; text-align: center;">
                <tr>
                    <td align="center">
                        <div style="width: 48px; height: 48px; background-color: #2B4E32; border-radius: 50%; display: inline-block; vertical-align: middle;">
                            <img src="https://s3.us-west-004.backblazeb2.com/backblazetestbucket/3b02cd94-38ef-4c91-a9c8-2bb472ef644a-RENTROI_Emaillogo.png" alt="Logo" width="30" style="padding-top: 10px; display: block; border: 0; margin: 0 auto;">
                        </div>

                        <div style="color: #697586; font-size: 14px; margin: 16px 0 4px; font-weight: 400;">
                            © {{currentYear}} Rent Roi All rights reserved.
                        </div>

                        <div style="color: #344054; font-size: 14px; font-weight: 400;">
                            Contact us at
                            <a href="mailto:support@rentroi.uk" style="color: #3B82F6; text-decoration: none; font-size: 13px;">
                                support@rentroi.uk
                            </a>
                        </div>
                    </td>
                </tr>
            </table>

        </td>
    </tr>
</table>
