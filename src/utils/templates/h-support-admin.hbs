<!DOCTYPE html >
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New ticket - Rent ROI</title>
</head>
<body style="margin: 0; padding: 0; background-color: #F9FAFB; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">
<table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #F9FAFB; padding: 40px 10px;">
    <tr>
        <td align="center">
            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 500px; background-color: #ffffff; border-radius: 12px; border: 1px solid #F3F4F6; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
                <tr>
                    <td style="padding: 40px 40px; text-align: center;">

                        <table border="0" cellpadding="0" cellspacing="0" align="center" style="margin-bottom: 24px;">
                            <tr>
                                <td align="center" style="width: 60px; height: 60px;  background-color: #ffffff;">
                                    <img src="https://s3.us-west-004.backblazeb2.com/backblazetestbucket/fc4fa09f-1764-4c95-950d-a74253460dc8-Frame_1321317019_1.png" alt="Reset" width="60" style="display: block; border: 0; margin: 0 auto;">
                                </td>
                            </tr>
                        </table>

                        <h2 style="color: #344054; font-size: 24px; font-weight: 600; margin: 0 0 30px 0; letter-spacing: -0.02em;">
                            New support request requires attention
                        </h2>

                        <table border="0" cellpadding="0" cellspacing="0" width="100%" style="border: 1px solid #F2F4F7; border-radius: 8px; padding: 30px 20px;">
                            <tr>
                                <td align="left">

                                    <p style="color: #475467; font-size: 14px; line-height: 1.5; margin: 0 0 16px 0; align:left">
                                        A new help request has just been submitted. Please review the details below and assign or respond to this ticket as soon as possible.
                                    </p>

                                    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:520px; margin:0 auto 16px; background-color:#FFFFFF; border:1px solid #F2F4F7; border-radius:10px; font-family:Helvetica Neue, sans-serif;">
                                        <tr>
                                            <td style="padding:8px 20px;">

                                                <table width="100%" cellpadding="0" cellspacing="0" border="0">

                                                    <tr>
                                                        <td style="padding:10px 0; border-bottom:1px solid #EAECF0; color:#475467; font-size:14px;">
                                                            Send by
                                                        </td>
                                                        <td align="right" style="padding:12px 0; border-bottom:1px solid #EAECF0;">

                                                            <table cellpadding="0" cellspacing="0" border="0" align="right">
                                                                <tr>

                                                                    {{#if avatar}}
                                                                        <td align="center" style="width: 38px; height: 38px; border-radius: 50%;">
                                                                            <img src="{{avatar}}" alt="Avatar" width="38" style="display: block; margin: 0 auto;">
                                                                        </td>
                                                                    {{/if}}

                                                                    <td style="vertical-align:middle; text-align:left; padding-left:4px;">
                                                                        <div style="color:#111111; font-size:14px; font-weight:500;">
                                                                            {{fullname}}
                                                                        </div>
                                                                        <div style="color:#667085; font-size:12px;">
                                                                            {{email}}
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                            </table>

                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td style="padding:12px 0; border-bottom:1px solid #EAECF0; color:#475467; font-size:14px;">
                                                            Ticket ID
                                                        </td>
                                                        <td align="right" style="padding:12px 0; border-bottom:1px solid #EAECF0; color:#101828; font-size:14px; font-weight:600;">
                                                            {{label}}
                                                        </td>
                                                    </tr>

                                                    <tr>
                                                        <td style="padding:12px 0; border-bottom:1px solid #EAECF0; color:#475467; font-size:14px;">
                                                            Subject
                                                        </td>
                                                        <td align="right" style="padding:12px 0; border-bottom:1px solid #EAECF0; color:#101828; font-size:14px; font-weight:600;">
                                                            {{cLabel}}
                                                        </td>
                                                    </tr>

                                                    <tr>
                                                        <td style="padding:12px 0; border-bottom:1px solid #EAECF0; color:#475467; font-size:14px;">
                                                            Submitted
                                                        </td>
                                                        <td align="right" style="padding:14px 0; border-bottom:1px solid #EAECF0; color:#101828; font-size:14px; font-weight:600;">
                                                            {{createdAt}}
                                                        </td>
                                                    </tr>

                                                    <tr>
                                                        <td style="padding:14px 0; border-bottom:1px solid #EAECF0; color:#475467; font-size:16px;">
                                                            Status
                                                        </td>
                                                        <td align="right" style="padding:14px 0; border-bottom:1px solid #EAECF0;">
                                                            <span style="display:inline-block; padding:6px 14px; border:1px solid #16B364; border-radius:999px; background-color:#F6FEF9; color:#344054; font-size:14px; font-weight:500;">
                                                                Activated
                                                            </span>
                                                        </td>
                                                    </tr>

                                                    <tr>
                                                        <td style="padding:14px 0; color:#475467; font-size:14px;">
                                                            Category
                                                        </td>
                                                        <td align="right" style="padding:14px 0; color:#101828; font-size:14px; font-weight:600;">
                                                            Help &amp; Support
                                                        </td>
                                                    </tr>

                                                </table>

                                            </td>
                                        </tr>
                                    </table>



                                    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="">
                                        <tr>
                                            <td align="center">

                                                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                                    <tr>
                                                        <td align="center">
                                                            <a href={{link}} style="display: block; background-color: #F3FAF4; color: #3C7D4A; font-size: 14px; font-weight: 600; text-decoration: none; padding: 12px 20px; border-radius: 6px; ">
                                                                View and Respond
                                                            </a>
                                                        </td>
                                                    </tr>
                                                </table>

                                                <p style="color: #667085; font-size: 13px; line-height: 1.5; margin: 10px 0 10px 0; text-align: left;">
                                                    Button not working? Copy and paste this link into the address bar:
                                                </p>
                                                <p style="margin: 0; text-align: left; word-break: break-all;">
                                                    <a href={{link}} style="color: #3B82F6; font-size: 13px; text-decoration: none;">
                                                        {{link}}
                                                    </a>
                                                </p>
                                            </td>
                                        </tr>
                                    </table>

                                </td>
                            </tr>
                        </table>

                    </td>
                </tr>
            </table>

            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 500px; margin-top: 30px; text-align: center;">
                <tr>
                    <td align="center">
                        <table border="0" cellpadding="0" cellspacing="0" align="center">
                            <tr>
                                <td align="center" style="width: 48px; height: 48px; background-color: #2B4E32; border-radius: 50%;">
                                    <img src="https://s3.us-west-004.backblazeb2.com/backblazetestbucket/3b02cd94-38ef-4c91-a9c8-2bb472ef644a-RENTROI_Emaillogo.png" alt="Logo" width="28" style="display: block; margin: 0 auto;">
                                </td>
                            </tr>
                        </table>

                        <p style="color: #697586; font-size: 13px; margin: 15px 0 5px 0;">
                            &copy; {{curentYear}} Rent Roi All rights reserved.
                        </p>

                        <p style="color: #344054; font-size: 13px; margin: 0;">
                            Contact us at
                            <a href="mailto:support@rentroi.uk" style="color: #3B82F6; text-decoration: none;">
                                support@rentroi.uk
                            </a>
                        </p>
                    </td>
                </tr>
            </table>

        </td>
    </tr>
</table>
</body>
</html>